{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Edit(/spec/**)"
    ],
    "deny": [
      "Edit(/api/**)",
      "Edit(/legacy/unity/**)",
      "Read(/legacy/unity/*.keystore)",
      "Read(/legacy/unity/*.apk)",
      "Read(/legacy/unity/*.aab)",
      "Read(/legacy/unity/*.csproj)",
      "Read(/legacy/unity/*.sln)",
      "Read(/legacy/unity/*.eps)",
      "Read(/legacy/unity/.collabignore)",
      "Read(/legacy/unity/.vs/**)",
      "Read(/legacy/unity/.vscode/**)",
      "Read(/legacy/unity/Build/**)",
      "Read(/legacy/unity/Library/**)",
      "Read(/legacy/unity/ProjectSettings/**)",
      "Read(/legacy/unity/Packages/**)",
      "Read(/legacy/unity/UserSettings/**)",
      "Read(/legacy/unity/Logs/**)",
      "Read(/legacy/unity/Temp/**)",
      "Read(/legacy/unity/Assets/*.cs)",
      "Read(/legacy/unity/Assets/承認とアプリバージョン/**)",
      "Read(/legacy/unity/Assets/データベース/**)",
      "Read(/legacy/unity/Assets/シーン/**)",
      "Read(/legacy/unity/Assets/SaveData/**)",
      "Read(/legacy/unity/Assets/Scripts/**)",
      "Read(/legacy/unity/Assets/Resources/**)",
      "Read(/legacy/unity/Assets/Plugins/**)",
      "Read(/legacy/unity/Assets/LitJson/**)",
      "Read(/legacy/unity/Assets/font/**)",
      "Read(/legacy/unity/Assets/TextMesh Pro/**)",
      "Read(**/.env)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in */web/src/*.ts|*/web/src/*.tsx) cd \"${f%%/web/src/*}/web\" && pnpm exec prettier --write --log-level warn \"$f\" && pnpm exec eslint --fix \"$f\";; */web/src/*.css) cd \"${f%%/web/src/*}/web\" && pnpm exec prettier --write --log-level warn \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "web のファイルを整形しています"
          }
        ]
      }
    ]
  }
}
